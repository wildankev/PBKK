<Window x:Class="TutorMate.Views.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TutorMate - Register" WindowState="Maximized" WindowStartupLocation="CenterScreen" Background="#2C3E50">

    <Grid>
        <Border Background="White" CornerRadius="15" Padding="35" 
                VerticalAlignment="Center" HorizontalAlignment="Center" Width="420" Height="520">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="25" Opacity="0.3" ShadowDepth="5"/>
            </Border.Effect>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Daftar Akun Pengguna" FontSize="26" FontWeight="Bold" Foreground="#2C3E50" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <TextBlock Text="NIM:" FontWeight="SemiBold" Foreground="#34495E"/>
                <TextBox x:Name="txtNIM" />

                <TextBlock Text="Nama Lengkap:" FontWeight="SemiBold" Foreground="#34495E"/>
                <TextBox x:Name="txtNama" />

                <TextBlock Text="Password:" FontWeight="SemiBold" Foreground="#34495E"/>
                <PasswordBox x:Name="txtPassword" />

                <TextBlock Text="Mendaftar Sebagai:" FontWeight="SemiBold" Foreground="#34495E"/>
                <ComboBox x:Name="cmbRole" Margin="0,5,0,20" Padding="8">
                    <ComboBoxItem Content="Peserta" IsSelected="True"/>
                    <ComboBoxItem Content="Mentor"/>
                </ComboBox>

                <Button Content="BUAT AKUN" Style="{StaticResource ModernButton}" Click="BtnRegister_Click" Background="#2ECC71" Height="40" Margin="0,5,0,15"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="Sudah punya akun? " Foreground="#7F8C8D"/>
                    <TextBlock Text="Kembali ke Login" Foreground="#3498DB" Cursor="Hand" TextDecorations="Underline" MouseLeftButtonDown="TextBlock_BackToLogin_Click" FontWeight="Bold"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>