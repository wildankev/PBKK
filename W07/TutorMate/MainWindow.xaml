<Window x:Class="TutorMate.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TutorMate - Sistem Pendataan Tutor" WindowState="Maximized" WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#2C3E50">
            <StackPanel Margin="20,30,20,20">
                <TextBlock Text="TutorMate" FontSize="26" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <TextBlock x:Name="TxtInfoUser" Text="User (Role)" FontSize="12" Foreground="#BDC3C7" HorizontalAlignment="Center" Margin="0,0,0,30"/>

                <Button Content="📚 List Tutor" Style="{StaticResource ModernButton}" Background="#34495E" HorizontalContentAlignment="Left" Padding="15,10" Margin="0,0,0,10" Click="MenuDaftarTutor_Click"/>
                <Button Content="📖 Katalog Mata Kuliah" Style="{StaticResource ModernButton}" Background="#34495E" HorizontalContentAlignment="Left" Padding="15,10" Margin="0,0,0,10" Click="MenuKatalogMK_Click"/>

                <Button x:Name="BtnFormDaftarTutor" Content="📝 Form Daftar Tutor" Style="{StaticResource ModernButton}" Background="#1ABC9C" HorizontalContentAlignment="Left" Padding="15,10" Margin="0,0,0,10" Click="MenuFormDaftarTutor_Click"/>

                <Button x:Name="BtnFormTambahMK" Content="➕ Tambah Matkul Baru" Style="{StaticResource ModernButton}" Background="#E67E22" HorizontalContentAlignment="Left" Padding="15,10" Margin="0,0,0,10" Click="MenuFormTambahMK_Click"/>

                <Button Content="🚪 Logout" Style="{StaticResource ModernButton}" Background="#E74C3C" HorizontalContentAlignment="Left" Padding="15,10" Margin="0,120,0,0" Click="BtnLogout_Click"/>
            </StackPanel>
        </Border>
        <Grid Grid.Column="1" Background="#ECF0F1">
            <Grid Margin="25">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="TxtJudulHalaman" Text="List Tutor" FontSize="26" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,20"/>

                <Border x:Name="PanelDaftarTutor" Grid.Row="1" Background="White" CornerRadius="10" Padding="20" Visibility="Visible">
                    <DataGrid x:Name="DgTutor" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nama Tutor" Binding="{Binding NamaTutor}" Width="180"/>
                            <DataGridTextColumn Header="Mata Kuliah" Binding="{Binding NamaMataKuliah}" Width="200"/>
                            <DataGridTextColumn Header="Nilai Matkul" Binding="{Binding NilaiHuruf}" Width="100"/>
                            <DataGridTextColumn Header="Jadwal Bimbingan" Binding="{Binding HariJadwal}" Width="180"/>
                            <DataGridTextColumn Header="Topik Keahlian" Binding="{Binding TopikKeahlian}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <Border x:Name="PanelKatalogMK" Grid.Row="1" Background="White" CornerRadius="10" Padding="20" Visibility="Collapsed">
                    <DataGrid x:Name="DgMatkul" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding SubjectId}" Width="60"/>
                            <DataGridTextColumn Header="Kode MK" Binding="{Binding KodeMK}" Width="120"/>
                            <DataGridTextColumn Header="Nama Mata Kuliah" Binding="{Binding NamaMataKuliah}" Width="250"/>
                            <DataGridTextColumn Header="Deskripsi" Binding="{Binding Deskripsi}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <Border x:Name="PanelFormDaftarTutor" Grid.Row="1" Background="White" CornerRadius="10" Padding="25" Visibility="Collapsed" Width="500" HorizontalAlignment="Left">
                    <StackPanel>
                        <TextBlock Text="Form Pendaftaran Tutor" FontSize="18" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,20"/>

                        <TextBlock Text="Pilih Mata Kuliah:" Foreground="#7F8C8D"/>
                        <ComboBox x:Name="CmbSubjectList" DisplayMemberPath="NamaMataKuliah" SelectedValuePath="SubjectId" Margin="0,5,0,15" Padding="8"/>

                        <TextBlock Text="Hari:" Foreground="#7F8C8D"/>
                        <TextBox x:Name="TxtHariJadwal" />

                        <Button Content="DAFTAR" Style="{StaticResource ModernButton}" Background="#1ABC9C" Click="BtnSimpanTutor_Click" Margin="0,15,0,0"/>
                    </StackPanel>
                </Border>

                <Border x:Name="PanelFormTambahMK" Grid.Row="1" Background="White" CornerRadius="10" Padding="25" Visibility="Collapsed" Width="500" HorizontalAlignment="Left">
                    <StackPanel>
                        <TextBlock Text="Usulkan Mata Kuliah Baru" FontSize="18" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,20"/>

                        <TextBlock Text="Kode Mata Kuliah:" Foreground="#7F8C8D"/>
                        <TextBox x:Name="TxtKodeMK" />

                        <TextBlock Text="Nama Mata Kuliah:" Foreground="#7F8C8D"/>
                        <TextBox x:Name="TxtNamaMK" />

                        <TextBlock Text="Deskripsi Singkat:" Foreground="#7F8C8D"/>
                        <TextBox x:Name="TxtDeskripsiMK" Height="60" TextWrapping="Wrap" AcceptsReturn="True"/>

                        <Button Content="TAMBAH" Style="{StaticResource ModernButton}" Background="#E67E22" Click="BtnSimpanMK_Click" Margin="0,15,0,0"/>
                    </StackPanel>
                </Border>

            </Grid>
        </Grid>
    </Grid>
</Window>