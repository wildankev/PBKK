<Window x:Class="StudentRegistrationApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Student Registration App - PBKK C"
        Height="580"
        Width="880"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F9">

    <Window.Resources>
        <!-- Style Tombol Rounded Modern -->
        <Style x:Key="RoundedButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style Input TextBox -->
        <Style x:Key="FormInputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#CED4DA"/>
            <Setter Property="Background" Value="White"/>
        </Style>
    </Window.Resources>

    <Grid Margin="25">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- PANEL KIRI: FORM REGISTRASI -->
        <Border Grid.Column="0"
                Background="White"
                CornerRadius="8"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                Padding="22">
            <StackPanel>
                <TextBlock Text="REGISTRASI MAHASISWA"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="#1E293B"
                           Margin="0,0,0,18"/>

                <!-- Input NRP -->
                <TextBlock Text="NRP Mahasiswa" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                <TextBox x:Name="txtNrp" Style="{StaticResource FormInputStyle}" Margin="0,0,0,12"/>

                <!-- Input Nama -->
                <TextBlock Text="Nama Lengkap" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                <TextBox x:Name="txtNama" Style="{StaticResource FormInputStyle}" Margin="0,0,0,12"/>

                <!-- Input Program Studi -->
                <TextBlock Text="Program Studi" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                <ComboBox x:Name="cmbProdi"
                          Height="34"
                          VerticalContentAlignment="Center"
                          Margin="0,0,0,14"
                          Background="White">
                    <ComboBoxItem Content="Teknik Informatika"/>
                    <ComboBoxItem Content="Sistem Informasi"/>
                    <ComboBoxItem Content="Sains Data"/>
                    <ComboBoxItem Content="Teknik Komputer"/>
                    <ComboBoxItem Content="Rekayasa Perangkat Lunak"/>
                </ComboBox>

                <!-- Input Jenis Kelamin -->
                <TextBlock Text="Jenis Kelamin" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,22">
                    <RadioButton x:Name="rbLaki" Content="Laki-laki" Margin="0,0,24,0" FontSize="13" Foreground="#334155"/>
                    <RadioButton x:Name="rbPerempuan" Content="Perempuan" FontSize="13" Foreground="#334155"/>
                </StackPanel>

                <!-- Tombol Aksi Form -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="btnSimpan"
                            Grid.Column="0"
                            Content="Simpan Data"
                            Height="38"
                            Background="#16A34A"
                            Style="{StaticResource RoundedButtonStyle}"
                            Click="BtnSimpan_Click"/>

                    <Button x:Name="btnReset"
                            Grid.Column="2"
                            Content="Reset Form"
                            Height="38"
                            Background="#64748B"
                            Style="{StaticResource RoundedButtonStyle}"
                            Click="BtnReset_Click"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- PANEL KANAN: DAFTAR MAHASISWA -->
        <Border Grid.Column="2"
                Background="White"
                CornerRadius="8"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                Padding="22">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="DAFTAR MAHASISWA"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="#1E293B"
                           Margin="0,0,0,16"/>

                <ListBox x:Name="lstMahasiswa"
                         Grid.Row="1"
                         BorderThickness="1"
                         BorderBrush="#F1F5F9"
                         Background="#FAFAFA"
                         Padding="6"
                         HorizontalContentAlignment="Stretch">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#E2E8F0"
                                    BorderThickness="0,0,0,1"
                                    Padding="10,10"
                                    Background="White"
                                    CornerRadius="4"
                                    Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Informasi Mahasiswa -->
                                    <TextBlock Text="{Binding}"
                                               VerticalAlignment="Center"
                                               FontSize="13"
                                               Foreground="#1E293B"/>

                                    <!-- Tombol Aksi Per Item -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="Edit"
                                                Width="55"
                                                Height="28"
                                                Margin="0,0,6,0"
                                                Background="#0284C7"
                                                FontSize="11"
                                                Style="{StaticResource RoundedButtonStyle}"
                                                Click="BtnItemUpdate_Click"/>

                                        <Button Content="Hapus"
                                                Width="55"
                                                Height="28"
                                                Background="#E11D48"
                                                FontSize="11"
                                                Style="{StaticResource RoundedButtonStyle}"
                                                Click="BtnItemDelete_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</Window>
