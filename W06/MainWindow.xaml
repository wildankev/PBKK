<Window x:Class="StudentRegistrationApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Student Registration App (SISMA) - PBKK Pertemuan 6"
        Height="740" Width="1160"
        MinHeight="620" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F9"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Card Style -->
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <!-- Form Label -->
        <Style x:Key="FormLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#475569" />
            <Setter Property="Margin" Value="0,6,0,3" />
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <!-- 0: Header & Stats -->
            <RowDefinition Height="Auto" />
            <!-- 1: Main Content (Form & DataGrid) -->
            <RowDefinition Height="*" />
            <!-- 2: Status Bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================= SECTION 0: HEADER & STATS ================= -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <!-- App Bar Header -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="SISTEM REGISTRASI MAHASISWA (SISMA)"
                               FontSize="20" FontWeight="Bold" Foreground="#0F172A" />
                    <TextBlock Text="PBKK Pertemuan 6 - Integrasi WPF Desktop &amp; SQL Server Database (ADO.NET)"
                               FontSize="12" Foreground="#64748B" Margin="0,2,0,0" />
                </StackPanel>

                <!-- Database Status Pill -->
                <Border Grid.Column="1" Background="#ECFDF5" BorderBrush="#10B981" BorderThickness="1"
                        CornerRadius="16" Padding="12,5" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="#10B981" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding DatabaseStatus}"
                                   FontSize="12" FontWeight="SemiBold" Foreground="#065F46" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Stat Cards Row -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Card 1: Total Mahasiswa -->
                <Border Grid.Column="0" Margin="0,0,8,0" Style="{StaticResource CardBorderStyle}">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Total Mahasiswa" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" />
                            <TextBlock Text="{Binding TotalStudents}" FontSize="24" FontWeight="Bold" Foreground="#0D47A1" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Card 2: Teknik Informatika -->
                <Border Grid.Column="1" Margin="4,0,8,0" Style="{StaticResource CardBorderStyle}">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Teknik Informatika" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" />
                            <TextBlock Text="{Binding TotalInformatika}" FontSize="24" FontWeight="Bold" Foreground="#0288D1" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Card 3: Sistem Informasi -->
                <Border Grid.Column="2" Margin="4,0,8,0" Style="{StaticResource CardBorderStyle}">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Sistem Informasi" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" />
                            <TextBlock Text="{Binding TotalSistemInformasi}" FontSize="24" FontWeight="Bold" Foreground="#2E7D32" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Card 4: Mahasiswa Aktif -->
                <Border Grid.Column="3" Margin="4,0,0,0" Style="{StaticResource CardBorderStyle}">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Pengguna Aktif" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" />
                            <TextBlock Text="A. Wildan Kevin" FontSize="16" FontWeight="Bold" Foreground="#1E293B" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="NRP: 5025241265" FontSize="11" Foreground="#64748B" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </StackPanel>

        <!-- ================= SECTION 1: MAIN CONTENT ================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Form Column -->
                <ColumnDefinition Width="380" />
                <!-- Table Column -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- LEFT: REGISTRATION FORM CARD -->
            <Border Grid.Column="0" Margin="0,0,12,0" Style="{StaticResource CardBorderStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Form Header -->
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="{Binding FormTitle}"
                                       FontSize="15" FontWeight="Bold" Foreground="#0F172A" />
                        </Grid>
                        <Separator Background="#E2E8F0" Margin="0,0,0,8" />

                        <!-- NIM -->
                        <TextBlock Text="NIM / NRP *" Style="{StaticResource FormLabelStyle}" />
                        <TextBox Text="{Binding NIM, UpdateSourceTrigger=PropertyChanged}" />

                        <!-- Nama Lengkap -->
                        <TextBlock Text="Nama Lengkap *" Style="{StaticResource FormLabelStyle}" />
                        <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" />

                        <!-- Program Studi -->
                        <TextBlock Text="Program Studi *" Style="{StaticResource FormLabelStyle}" />
                        <ComboBox ItemsSource="{Binding Programs}"
                                  SelectedItem="{Binding SelectedProgram}"
                                  DisplayMemberPath="DisplayName" />

                        <!-- Email -->
                        <TextBlock Text="Email Kampus (@student.its.ac.id)" Style="{StaticResource FormLabelStyle}" />
                        <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />

                        <!-- Jenis Kelamin -->
                        <TextBlock Text="Jenis Kelamin *" Style="{StaticResource FormLabelStyle}" />
                        <ComboBox ItemsSource="{Binding GenderList}"
                                  SelectedItem="{Binding Gender}"
                                  Margin="0,0,0,6" />

                        <!-- Tanggal Lahir -->
                        <TextBlock Text="Tanggal Lahir" Style="{StaticResource FormLabelStyle}" />
                        <DatePicker SelectedDate="{Binding BirthDate}" />

                        <!-- No. Telepon -->
                        <TextBlock Text="Nomor Telepon / WhatsApp" Style="{StaticResource FormLabelStyle}" />
                        <TextBox Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}" />

                        <!-- Alamat -->
                        <TextBlock Text="Alamat Domisili" Style="{StaticResource FormLabelStyle}" />
                        <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"
                                 Height="55" TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalContentAlignment="Top" />

                        <!-- Action Buttons -->
                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Content="{Binding SaveButtonText}"
                                    Command="{Binding SaveCommand}"
                                    Background="#0D47A1" Foreground="#FFFFFF"
                                    FontWeight="SemiBold" FontSize="13"
                                    Padding="14,10" BorderThickness="0"
                                    Cursor="Hand" Margin="0,0,8,0" />

                            <Button Grid.Column="1" Content="Reset"
                                    Command="{Binding ResetFormCommand}"
                                    Background="#F1F5F9" Foreground="#334155"
                                    FontWeight="SemiBold" FontSize="13"
                                    Padding="14,10" BorderBrush="#CBD5E1" BorderThickness="1"
                                    Cursor="Hand" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- RIGHT: SEARCH & DATAGRID CARD -->
            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Filter Bar -->
                        <RowDefinition Height="Auto" />
                        <!-- DataGrid -->
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Filter Bar -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Search Box -->
                        <TextBox Grid.Column="0"
                                 Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,8,0"
                                 ToolTip="Ketik untuk mencari berdasarkan NIM, Nama, Email, atau Program Studi" />

                        <!-- Filter Program -->
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding Programs}"
                                  SelectedItem="{Binding FilterProgram}"
                                  DisplayMemberPath="ProgramName"
                                  Margin="0,0,8,0" />

                        <!-- Refresh Button -->
                        <Button Grid.Column="2" Content="Muat Ulang"
                                Command="{Binding RefreshCommand}"
                                Background="#F1F5F9" Foreground="#334155"
                                FontWeight="SemiBold" FontSize="12"
                                Padding="12,7" BorderBrush="#CBD5E1" BorderThickness="1"
                                Cursor="Hand" />
                    </Grid>

                    <!-- Student DataGrid -->
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Students}"
                              SelectedItem="{Binding SelectedStudent}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#E2E8F0"
                              RowHeight="36"
                              FontSize="12"
                              Background="#FFFFFF"
                              BorderThickness="1"
                              BorderBrush="#E2E8F0">
                        <DataGrid.Columns>
                            <!-- NIM -->
                            <DataGridTextColumn Header="NIM" Binding="{Binding NIM}" Width="105" FontWeight="SemiBold" />

                            <!-- Nama Lengkap -->
                            <DataGridTextColumn Header="Nama Lengkap" Binding="{Binding FullName}" Width="170" />

                            <!-- Program Studi -->
                            <DataGridTextColumn Header="Program Studi" Binding="{Binding ProgramName}" Width="150" />

                            <!-- Email -->
                            <DataGridTextColumn Header="Email Mahasiswa" Binding="{Binding Email}" Width="190" />

                            <!-- Gender -->
                            <DataGridTextColumn Header="Gender" Binding="{Binding Gender}" Width="85" />

                            <!-- No. Telepon -->
                            <DataGridTextColumn Header="Telepon" Binding="{Binding PhoneNumber}" Width="110" />

                            <!-- Aksi Column -->
                            <DataGridTemplateColumn Header="Aksi" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Content="Hapus"
                                                    Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Background="#FEE2E2" Foreground="#991B1B"
                                                    BorderBrush="#FCA5A5" BorderThickness="1"
                                                    FontWeight="SemiBold" FontSize="11"
                                                    Padding="8,3" Cursor="Hand" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- ================= SECTION 2: STATUS BAR ================= -->
        <Border Grid.Row="2" Margin="0,12,0,0" Background="#FFFFFF"
                BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}"
                           FontSize="12" Foreground="#475569" VerticalAlignment="Center" />

                <TextBlock Grid.Column="1" Text="A. Wildan Kevin Assyauqi | 5025241265 | PBKK C"
                           FontSize="12" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
